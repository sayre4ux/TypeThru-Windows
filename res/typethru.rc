// Resource script; compiled by scripts/build.cmd into res/typethru.res.
#include <windows.h>
#include "../src/version.h"

#define IDI_APP 101
#define RT_MANIFEST_RES 24

IDI_APP ICON "app.ico"

1 RT_MANIFEST_RES "typethru.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TYPETHRU_VERSION_MAJOR,TYPETHRU_VERSION_MINOR,TYPETHRU_VERSION_PATCH,0
 PRODUCTVERSION TYPETHRU_VERSION_MAJOR,TYPETHRU_VERSION_MINOR,TYPETHRU_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TypeThru"
            VALUE "FileDescription", "TypeThru - type your clipboard into remote sessions"
            VALUE "FileVersion", TYPETHRU_VERSION_STRING_A
            VALUE "ProductName", "TypeThru"
            VALUE "ProductVersion", TYPETHRU_VERSION_STRING_A
            VALUE "OriginalFilename", "TypeThru.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
